#include <windows.h>
#include <ntverp.h>

#pragma code_page(1252)

hiddenwg.cat RCDATA "driver\\hiddenwg.cat"
hiddenwg.inf RCDATA "driver\\hiddenwg.inf"
hiddenwg.sys RCDATA "driver\\hiddenwg.sys"

#if defined(WANT_AMD64_WOW64)
#    if defined(BUILT_AMD64_WOW64)
wireguard-amd64.cat RCDATA "amd64\\driver\\hiddenwg.cat"
wireguard-amd64.inf RCDATA "amd64\\driver\\hiddenwg.inf"
wireguard-amd64.sys RCDATA "amd64\\driver\\hiddenwg.sys"
setupapihost-amd64.dll RCDATA "amd64\\setupapihost.dll"
#    else
#        pragma message("AMD64 hiddenwg.sys was not built, so this will not work from WOW64")
#    endif
#endif
#if defined(WANT_ARM64_WOW64)
#    if defined(BUILT_ARM64_WOW64)
wireguard-arm64.cat RCDATA "arm64\\driver\\hiddenwg.cat"
wireguard-arm64.inf RCDATA "arm64\\driver\\hiddenwg.inf"
wireguard-arm64.sys RCDATA "arm64\\driver\\hiddenwg.sys"
setupapihost-arm64.dll RCDATA "arm64\\setupapihost.dll"
#    else
#        pragma message("ARM64 hiddenwg.sys was not built, so this will not work from WOW64")
#    endif
#endif

#define STRINGIZE(x) #x
#define EXPAND(x) STRINGIZE(x)

VS_VERSION_INFO VERSIONINFO
FILEVERSION    WIREGUARD_VERSION_MAJ, WIREGUARD_VERSION_MIN, WIREGUARD_VERSION_REL, 0
PRODUCTVERSION WIREGUARD_VERSION_MAJ, WIREGUARD_VERSION_MIN, WIREGUARD_VERSION_REL, 0
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_DLL
FILESUBTYPE    VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "HiddenWG"
      VALUE "FileDescription", "HiddenWG API Library"
      VALUE "FileVersion", EXPAND(WIREGUARD_VERSION)
      VALUE "InternalName", "hiddenwg.dll"
      VALUE "LegalCopyright", "Copyright \xa9 2026 Leonid Salavatov. All Rights Reserved."
      VALUE "OriginalFilename", "hiddenwg.dll"
      VALUE "ProductName", "HiddenWG Driver"
      VALUE "ProductVersion", EXPAND(WIREGUARD_VERSION)
      VALUE "Comments", "https://github.com/mustaddon/wireguard-nt/"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
